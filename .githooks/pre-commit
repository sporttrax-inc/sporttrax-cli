#!/bin/sh
# Mechanical guardrails — mirrors section 1 of the precommit audit skill.
# Activated by `make setup` (git config core.hooksPath .githooks).
set -e

fail() { echo "pre-commit: $1" >&2; exit 1; }

unformatted=$(gofmt -l .)
[ -z "$unformatted" ] || fail "gofmt needed: $unformatted"

go vet ./... || fail "go vet"

if command -v golangci-lint >/dev/null 2>&1; then
  golangci-lint run ./... || fail "golangci-lint"
else
  echo "pre-commit: golangci-lint not installed (brew install golangci-lint) — skipping" >&2
fi

go test ./... > /dev/null || fail "tests"

go mod tidy -diff > /dev/null 2>&1 || fail "go.mod not tidy (run: go mod tidy)"

make docs > /dev/null 2>&1
git diff --exit-code --quiet -- docs || fail "docs drifted (run: make docs && git add docs)"

echo "pre-commit: all checks passed"
